{
  "name": "portfolio-server",
  "version": "1.0.0",
  "description": "Express backend with SQLite for video editing portfolio",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "build:client": "npm install --prefix ../client --include=dev && npm run build --prefix ../client",
    "postinstall": "node -e \"process.env.RENDER && require('child_process').execSync('npm run build:client',{stdio:'inherit'})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
