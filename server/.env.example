# Copy to server/.env and fill in. Never commit .env.

# Google OAuth client (docs/GOOGLE-SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Local: http://localhost:5000/api/google/callback   Live: https://YOUR-SITE.netlify.app/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Optional: set after connecting once, so the connection survives a database reset on the host.
GOOGLE_REFRESH_TOKEN=

# Production behind Netlify -> Render proxies: number of proxy hops, so PIN lockout sees real IPs.
# TRUST_PROXY=2

# Database backup to your own Supabase project (needed on hosts that wipe files, e.g. Render free).
# Set these ONLY on the live server, so local testing never overwrites live data.
SUPABASE_URL=
SUPABASE_KEY=
STATE_TOKEN=

# Secret for the free keep-awake ping: https://YOUR-SERVER/api/cron?key=CRON_SECRET (cron-job.org, every 10 min)
CRON_SECRET=
